+    sessions.set(id, session);
+    reservedBytes += input.size;
+    activeUploads++;
+    budget.reserved += input.size;
+    budget.active++;
+    try {
+      session.directory = await mkdtemp(join(tmpdir(), PRIVATE_PREFIX));
+      session.path = join(session.directory, "original");
