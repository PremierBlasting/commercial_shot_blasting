+      await file.close();
+      return { uploadId: id, chunkSize: ENQUIRY_CHUNK_BYTES };
+    } catch {
+      await dispose(session).catch(() => undefined);
+      throw storageFailure();
+    } finally { session.pending--; }
+  }),
